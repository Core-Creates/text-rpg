# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.js

# build output
build/
dist/
.vite/

# testing
coverage/

# environment. The bare .env is listed deliberately: without it, a local file
# holding credentials would be picked up by a plain `git add -A`.
.env
.env.*
!.env.example

# large media, kept out of the repository and served from S3 instead
*.wav
*.mp4
*.flac

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
